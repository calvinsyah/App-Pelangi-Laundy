# Contoh konfigurasi environment untuk Pelangi Laundry

# [Environment: Development (Lokal)]
# Simpan di file: .env.development
# Gunakan Supabase CLI (supabase start) untuk environment lokal
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=ey...

# Kredensial untuk testing otomatis (Playwright E2E)
TEST_EMAIL=test@local.dev
TEST_PASSWORD=testpassword123

# [Environment: Production]
# Simpan di file: .env.production
# Atur ini di Vercel / Cloudflare Pages Dashboard environment variables
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=ey...
